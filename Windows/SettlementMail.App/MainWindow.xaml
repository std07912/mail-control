<Window x:Class="SettlementMail.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="정산자료 전송 도우미 · Windows" Width="1320" Height="850" MinWidth="1100" MinHeight="720" AllowDrop="True" PreviewDrop="FilesDropped" PreviewDragOver="FilesDragged" Closing="WindowClosing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142F43" Padding="18,28">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24"><TextBlock Text="정산자료" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="전송 도우미" Foreground="#9BB7C7" FontSize="14" Margin="0,6,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0"><TextBlock Text="내 PC에서 안전하게" Foreground="#C0D4DF"/><TextBlock Text="문서 정리 · 네이버 메일" Foreground="#7E9CAE" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    <StackPanel>
     <RadioButton x:Name="FileNav" Content="01   파일 정리" Style="{StaticResource Nav}" IsChecked="True" Click="Navigate" Tag="0"/>
     <RadioButton Content="02   파일 처리" Style="{StaticResource Nav}" Click="Navigate" Tag="1"/>
     <RadioButton Content="03   메일 구성" Style="{StaticResource Nav}" Click="Navigate" Tag="2"/>
     <RadioButton x:Name="SendNav" Content="04   발송 현황" Style="{StaticResource Nav}" Click="Navigate" Tag="3"/>
     <RadioButton x:Name="SettingsNav" Content="05   설정 · 이력" Style="{StaticResource Nav}" Click="Navigate" Tag="4"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,18">
    <DockPanel><Button Content="현재 작업 취소" DockPanel.Dock="Right" Click="CancelWork" Style="{StaticResource Secondary}" IsEnabled="{Binding IsBusy}" Padding="12,7"/><StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><ProgressBar Height="3" Margin="0,9,12,0" IsIndeterminate="{Binding IsBusy}"/></StackPanel></DockPanel>
   </Border>
   <TabControl x:Name="Pages" Grid.Row="1" Style="{StaticResource Pages}">
    <TabItem>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,18,0">
       <StackPanel DockPanel.Dock="Top"><TextBlock Text="전송할 자료를 모으세요" Style="{StaticResource Heading}"/><TextBlock Text="파일이나 폴더를 이 창으로 끌어 놓아도 됩니다. 원본은 변경하지 않습니다." Style="{StaticResource Caption}"/>
        <WrapPanel Margin="0,0,0,14" IsEnabled="{Binding CanEdit}"><Button Content="+ 파일 추가" Click="AddFiles"/><Button Content="폴더 선택" Click="AddFolder" Style="{StaticResource Secondary}"/><Button x:Name="BulkExcludeButton" Content="미승인 형식 선택 해제" Click="ExcludeUnsupported" Style="{StaticResource Secondary}"/><Button Content="이름순 정렬" Click="SortFiles" Style="{StaticResource Secondary}" Margin="0,8,0,0"/></WrapPanel>
       </StackPanel>
       <Border Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="FileGrid" ItemsSource="{Binding Documents}" IsEnabled="{Binding CanEdit}" SelectionChanged="FileSelected">
        <DataGrid.Columns><DataGridCheckBoxColumn Header="선택" Binding="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" Width="52"/><DataGridTextColumn Header="파일명" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="크기" Binding="{Binding Size}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="155" IsReadOnly="True"/></DataGrid.Columns>
       </DataGrid></Border>
      </DockPanel>
      <StackPanel Grid.Column="1">
       <Border CornerRadius="18" Padding="22" Margin="0,0,0,16"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#193C50"/><GradientStop Color="#087F72" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel><TextBlock Text="선택한 문서" Foreground="#C0DFDB"/><TextBlock Text="{Binding SelectedCount,StringFormat={}{0}개}" FontSize="36" FontWeight="Bold" Foreground="White" Margin="0,13,0,3"/><TextBlock Text="{Binding SelectedSize}" Foreground="White" FontSize="18"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="선택 문서" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="SelectedFileInfo" Text="목록에서 문서를 선택하세요." TextWrapping="Wrap" Foreground="#647C8E" Margin="0,12,0,16"/><Button Content="문서 미리보기" Click="PreviewFile" Style="{StaticResource Secondary}" Margin="0,0,0,8"/><WrapPanel IsEnabled="{Binding CanEdit}"><Button Content="위로" Click="MoveUp" Style="{StaticResource Secondary}"/><Button Content="아래로" Click="MoveDown" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
      </StackPanel>
     </Grid>
    </TabItem>
    <TabItem>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,18,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="파일 처리" Style="{StaticResource Heading}"/><TextBlock Text="목록에서 ZIP 또는 PDF를 선택하고 필요한 처리를 진행하세요." Style="{StaticResource Caption}"/></StackPanel><Border Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="ProcessGrid" ItemsSource="{Binding Documents}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="파일명" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="크기" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="처리 안내" Binding="{Binding Note}" Width="190"/></DataGrid.Columns></DataGrid></Border></DockPanel>
      <StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="문서 준비" FontSize="18" FontWeight="Bold"/><TextBlock Text="ZIP 내부 목록을 먼저 확인합니다. PDF는 실제 생성 크기를 측정해 분할합니다." Style="{StaticResource Caption}" Margin="0,12,0,20"/><Button Content="ZIP 목록 확인 · 해제" Click="ExtractZip" Margin="0,0,0,10"/><Button Content="PDF 자동 분할" Click="SplitPdf" Style="{StaticResource Secondary}" Margin="0,0,0,10"/><Button Content="미승인 형식 선택 해제" Click="ExcludeUnsupported" Style="{StaticResource Secondary}" Margin="0,0,0,15"/><TextBlock Text="PDF 원본은 보존됩니다. 전자서명·인증정보가 분할본에 유지되지 않을 수 있습니다. 단일 페이지가 용량을 넘으면 별도 처리 상태로 표시됩니다." TextWrapping="Wrap" Foreground="#7B5F3C"/></StackPanel></Border></StackPanel>
     </Grid>
    </TabItem>
    <TabItem>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,18,0"><TextBlock Text="메일 구성" Style="{StaticResource Heading}"/><TextBlock Text="받는 사람과 첨부 목록을 검토하세요." Style="{StaticResource Caption}"/><Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding CanEdit}">
       <TextBlock Text="작업명" Style="{StaticResource Label}" Margin="0,0,0,7"/><TextBox x:Name="JobBox" Text="사후정산" TextChanged="PlanChanged"/>
       <TextBlock Text="수신자 이메일" Style="{StaticResource Label}"/><TextBox x:Name="RecipientBox" TextChanged="PlanChanged"/>
       <TextBlock Text="제목" Style="{StaticResource Label}"/><TextBox x:Name="SubjectBox" Text="정산자료" TextChanged="PlanChanged"/>
       <CheckBox x:Name="MinimizeBox" Content="메일 수 줄이기 (순서 변경 가능)" Margin="0,18,0,16" Checked="PlanChanged" Unchecked="PlanChanged"/>
       <Button Content="첨부 목록 구성하기" Click="PrepareMail" Margin="0,0,0,10"/><Button Content="전체 검토 후 발송 승인" Click="ApproveSend" Margin="0,0,0,12"/>
       <TextBlock Text="목록 구성만으로는 메일을 보내지 않습니다. 최종 승인 후에만 발송합니다." Style="{StaticResource Caption}" Margin="0"/>
      </StackPanel></Border></StackPanel>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="메일 미리보기" FontSize="18" FontWeight="Bold" Margin="0,6,0,18"/><ItemsControl ItemsSource="{Binding Draft}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><DockPanel><TextBlock Text="{Binding Size}" DockPanel.Dock="Right" Foreground="#087F72"/><TextBlock Text="{Binding Position,StringFormat=메일 {0}}" FontWeight="Bold"/></DockPanel><TextBlock Text="{Binding Subject}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,6" TextWrapping="Wrap"/><TextBlock Text="{Binding Recipient}" Foreground="#718396"/><TextBlock Text="{Binding Files}" TextWrapping="Wrap" Margin="0,15,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
     </Grid>
    </TabItem>
    <TabItem>
     <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="발송 현황" Style="{StaticResource Heading}"/><TextBlock Text="{Binding MailSummary}" Style="{StaticResource Caption}"/><WrapPanel Margin="0,0,0,14" IsEnabled="{Binding CanEdit}"><Button Content="선택 메일만 재시도" Click="RetryMail"/><Button Content="선택 작업의 대기 메일 이어 보내기" Click="ResumeBatch" Style="{StaticResource Secondary}"/><Button Content="접수 확인 결과 입력" Click="ResolveMail" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="SMTP 접수 성공은 수신기관의 실제 수신·다운로드 성공을 의미하지 않습니다. 불확실 상태는 자동 재발송하지 않습니다." Style="{StaticResource Caption}" Margin="0,16,0,0"/><Border Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="작업" Binding="{Binding Job}" Width="110"/><DataGridTextColumn Header="순번" Binding="{Binding Position}" Width="55"/><DataGridTextColumn Header="제목" Binding="{Binding Subject}" Width="*"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="130"/><DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="130"/><DataGridTextColumn Header="응답 · 오류" Binding="{Binding Detail}" Width="240"/></DataGrid.Columns></DataGrid></Border></DockPanel>
    </TabItem>
    <TabItem>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="설정 및 이력" Style="{StaticResource Heading}"/><TextBlock Text="계정은 한 번 저장하면 됩니다. 비밀번호는 Windows 사용자 계정으로 암호화합니다." Style="{StaticResource Caption}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Margin="0,0,18,0"><StackPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="네이버 메일 계정" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding Account}" Foreground="#087F72" Margin="0,10,0,3" TextWrapping="Wrap"/><TextBlock Text="네이버 이메일" Style="{StaticResource Label}"/><TextBox x:Name="EmailBox"/><TextBlock Text="애플리케이션 비밀번호 (변경 시 입력)" Style="{StaticResource Label}"/><PasswordBox x:Name="PasswordBox"/><WrapPanel Margin="0,16,0,14"><Button Content="계정 보안 저장" Click="SaveAccount"/><Button Content="SMTP 연결 테스트" Click="TestAccount" Style="{StaticResource Secondary}"/></WrapPanel><TextBlock Text="네이버의 2단계 인증과 IMAP/SMTP 사용 설정이 필요합니다. 연결 테스트는 메일을 보내지 않습니다." TextWrapping="Wrap" Foreground="#718396"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="기관 승인 기준" FontSize="18" FontWeight="Bold"/><TextBlock Text="기본값은 기관 승인을 의미하지 않습니다." Foreground="#8B6747" Margin="0,10,0,3"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="메일 첨부 합계 MB" Style="{StaticResource Label}"/><TextBox x:Name="AttachBox" Text="9" TextChanged="PlanChanged"/><TextBlock Text="PDF 목표 MB (1~9)" Style="{StaticResource Label}"/><TextBox x:Name="PdfBox" Text="9" TextChanged="PlanChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="개별 파일 MB" Style="{StaticResource Label}"/><TextBox x:Name="FileLimitBox" Text="9" TextChanged="PlanChanged"/><TextBlock Text="발송 간격 초 (10 이상 · 기본 30)" Style="{StaticResource Label}"/><TextBox x:Name="IntervalBox" Text="30" TextChanged="PlanChanged"/></StackPanel></Grid>
        <TextBlock Text="인코딩 후 전체 메시지 MB" Style="{StaticResource Label}"/><TextBox x:Name="MessageBoxLimit" Text="13" TextChanged="PlanChanged"/><TextBlock Text="승인 확장자 (쉼표 구분)" Style="{StaticResource Label}"/><TextBox x:Name="ExtensionsBox" Text="pdf,xls,xlsx,doc,docx,hwp,hwpx,jpg,jpeg,png" TextChanged="PlanChanged" TextWrapping="Wrap"/><Button Content="기준 저장" Click="SaveSettings" Margin="0,16,0,0"/>
       </StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,18,0,0"><WrapPanel IsEnabled="{Binding CanEdit}"><Button Content="CSV 발송내역 내보내기" Click="ExportHistory" Style="{StaticResource Secondary}"/><Button Content="완료 작업 임시파일 삭제" Click="ClearTemporary" Style="{StaticResource Secondary}"/></WrapPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
   </TabControl>
   <TextBlock Grid.Row="2" Text="{Binding Summary}" Foreground="#718396" FontSize="12" Margin="0,16,0,0"/>
  </Grid>
 </Grid>
</Window>
